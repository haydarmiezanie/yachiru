rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdminEmail() {
      return isAuthenticated() && (
        request.auth.token.email == 'idarstore24@gmail.com'
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSuperAdminEmail() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin' &&
        getUserData().status == 'approved'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Strict create rule: normal users can only create profile with role 'viewer' and status 'pending'
      allow create: if isAdmin() || (
        isOwner(userId) && (
          isSuperAdminEmail() || (
            request.resource.data.role == 'viewer' &&
            request.resource.data.status == 'pending'
          )
        )
      );
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // Connection probe rule for initial status checks
    match /test/{docId} {
      allow read: if true;
    }

    // Access Requests Collection
    match /access_requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Scans History Collection
    match /scans/{scanId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'auditor'));
      allow update, delete: if isAdmin();
    }

    // Scan Summaries Index Collection (Lightweight summaries for fast multi-instance listing)
    match /scan_summaries/{scanId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'auditor'));
      allow update, delete: if isAdmin();
    }
  }
}
