rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdminEmail() {
      return isAuthenticated() && (
        request.auth.token.email == '{{SUPER_ADMIN_EMAIL}}'
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSuperAdminEmail() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin' &&
        getUserData().status == 'approved'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow user creation:
      // - Admin or Super Admin
      // - Self-registration strictly restricted to role == 'viewer' AND status == 'pending'
      // - No user can self-assign auditor/admin role or approved status
      allow create: if isAdmin() || (
        isOwner(userId) && (
          isSuperAdminEmail() ||
          (request.resource.data.role == 'viewer' && request.resource.data.status == 'pending')
        )
      );
      // Allow update:
      // - Admin or Super Admin
      // - Owner can update non-privilege profile fields (e.g. displayName, photoURL),
      //   but MUST preserve role and status identically.
      // - NO self-approval or self-elevation to auditor/admin is ever permitted.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if isAdmin();
    }

    // Connection probe rule for initial status checks
    match /test/{docId} {
      allow read: if true;
    }

    // Access Requests Collection
    match /access_requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        requestId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      ));
      // Anyone authenticated can create an access request for themselves,
      // but status MUST be 'pending'. Self-approval is strictly forbidden.
      allow create: if isAuthenticated() && (
        requestId == request.auth.uid ||
        request.resource.data.uid == request.auth.uid ||
        (request.auth.token.email != null && request.resource.data.email == request.auth.token.email)
      ) && request.resource.data.status == 'pending';
      // Only Admin can approve, revoke, or delete access requests
      allow update, delete: if isAdmin();
    }

    // Scans History Collection
    match /scans/{scanId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        getUserData().role == 'admin' ||
        getUserData().role == 'auditor'
      ));
      allow update, delete: if isAdmin();
    }

    // Scan Summaries Index Collection
    match /scan_summaries/{scanId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        getUserData().role == 'admin' ||
        getUserData().role == 'auditor'
      ));
      allow update, delete: if isAdmin();
    }

    // SSH Host Keys TOFU Collection
    match /ssh_host_keys/{hostKeyId} {
      allow read, write: if isAdmin();
    }

    // Saved Connections Collection
    match /connections/{connectionId} {
      allow read, write: if isAdmin();
    }
  }
}
