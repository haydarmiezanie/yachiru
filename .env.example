# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional model name for the AI narrative synthesis (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# OPENAI_API_KEY: Optional. Required only if a user selects OpenAI as the AI provider
# and does not supply their own OpenAI API key in the UI.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# CLAUDE_API_KEY: Optional. Required only if a user selects Claude (Anthropic) as the AI provider
# and does not supply their own Claude API key in the UI.
CLAUDE_API_KEY="MY_CLAUDE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YACHIRU_API_KEY: Optional. If set, /api/analyze, /api/narrate,
# /api/test-connection, and /api/system-key-reset require this value via
# "Authorization: Bearer <key>". Leave unset to keep the app fully open for
# local/UI-only use (the default today).
YACHIRU_API_KEY=""

# YACHIRU_RATE_LIMIT_PER_MINUTE: Optional override for rate limiting on expensive
# endpoints (/api/analyze, /api/test-connection). Default is 30 requests per minute.
YACHIRU_RATE_LIMIT_PER_MINUTE="30"

