# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional model name for the AI narrative synthesis (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# OPENAI_API_KEY: Optional. Required only if a user selects OpenAI as the AI provider
# and does not supply their own OpenAI API key in the UI.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# CLAUDE_API_KEY: Optional. Required only if a user selects Claude (Anthropic) as the AI provider
# and does not supply their own Claude API key in the UI.
CLAUDE_API_KEY="MY_CLAUDE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YACHIRU_API_KEY: Secret key to authenticate programmatic API endpoints.
# When set, locks /api/analyze, /api/narrate, /api/test-connection, /api/verifications,
# /api/history, and /api/system-key-reset behind Bearer token authentication.
# In production (NODE_ENV=production), YACHIRU_API_KEY is required by default.
# Generate a new key with: npm run generate-api-key
YACHIRU_API_KEY=""

# YACHIRU_REQUIRE_API_KEY: Explicitly enforces API key requirement regardless of environment.
# If true and YACHIRU_API_KEY is unset, the server will fail fast and refuse to start.
YACHIRU_REQUIRE_API_KEY="false"

# YACHIRU_ALLOW_OPEN_API: Explicit override to allow running in NODE_ENV=production without
# an API key. Defaults to 'false' (production enforces API key by default).
YACHIRU_ALLOW_OPEN_API="false"

# YACHIRU_ALLOW_SYSTEM_LLM_KEY: Allows authenticated API callers to use server-configured
# LLM keys (GEMINI_API_KEY, etc.) for /api/narrate. Defaults to 'false' to prevent unauthorized
# quota spending. Callers should provide their own AI API keys.
YACHIRU_ALLOW_SYSTEM_LLM_KEY="false"

# YACHIRU_TRUST_PROXY: Reverse proxy trust configuration for express-rate-limit client IP identification.
# Set to hop count (e.g. "1") or boolean ("true") if running behind Nginx, Cloudflare, or AWS ALB.
# Defaults to unset (off).
YACHIRU_TRUST_PROXY=""

# YACHIRU_RATE_LIMIT_PER_MINUTE: Optional override for rate limiting on expensive
# endpoints (/api/analyze, /api/test-connection, /api/verifications). Default is 30 requests per minute.
YACHIRU_RATE_LIMIT_PER_MINUTE="30"

# YACHIRU_NARRATE_RATE_LIMIT_PER_MINUTE: Optional override for rate limiting on LLM
# narrative synthesis (/api/narrate) to conserve AI provider quota. Default is 15 requests per minute.
YACHIRU_NARRATE_RATE_LIMIT_PER_MINUTE="15"

# YACHIRU_DATA_DIR: Directory for verification session data persistence.
# Defaults to ./data. In Docker Compose, maps to /app/data volume mount.
YACHIRU_DATA_DIR="./data"

# YACHIRU_SSH_STRICT_HOST_KEY: Strict SSH host key checking.
# In production (NODE_ENV=production), defaults to 'true' (strict host key verification required).
# In non-production, defaults to 'false' (permissive with manual pinning).
# When strict, any connection without a pinned fingerprint matching the bastion is rejected.
YACHIRU_SSH_STRICT_HOST_KEY=""


