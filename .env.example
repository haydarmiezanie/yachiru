# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for OpenAI (ChatGPT) synthesis calls (gpt-4o, gpt-4o-mini, o3-mini).
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & API Protection
# YACHIRU_API_KEY: Secret key required to access /api/clickhouse/* and /api/history/* endpoints for machine clients.
# Clients must send this via 'x-api-key' header or 'Authorization: Bearer <key>'.
YACHIRU_API_KEY=

# REQUIRE_API_KEY / STRICT_AUTH: Defaults to 'true' in production (fail-closed).
# Enforces that all API calls must provide a valid Firebase ID token or YACHIRU_API_KEY.
REQUIRE_API_KEY=true
STRICT_AUTH=true

# SSRF Protection: Deny internal, loopback, link-local, and cloud metadata network ranges.
# Set to 'true' ONLY in isolated, non-production test environments where local ClickHouse scanning is required.
ALLOW_INTERNAL_CLUSTERS=false

# CORS Configuration
# ALLOWED_ORIGINS: Comma-separated list of allowed web origins (e.g. 'https://my-domain.com,http://localhost:3000').
# In production, ALLOWED_ORIGINS (or APP_URL) must be explicitly configured (fail-closed, never reflects arbitrary origins).
ALLOWED_ORIGINS=
LOG_LEVEL=info

# Privacy & Compliance Storage
# STORE_RAW_QUERIES: Set to 'false' (or PRIVACY_PRESERVING_HISTORY=true) for strict enterprise compliance environments.
# When disabled, Yachiru will NEVER persist raw SQL queries to disk, storing only normalized structural patterns & SHA-256 fingerprints.
STORE_RAW_QUERIES=true
PRIVACY_PRESERVING_HISTORY=false

# Scanner Resilience & DoS Protection
# CLICKHOUSE_QUERY_TIMEOUT_MS: Maximum time in milliseconds before an in-flight system query is aborted (default: 10000).
CLICKHOUSE_QUERY_TIMEOUT_MS=10000

# Scan History Persistence Engine
# USE_FIRESTORE_HISTORY: Set to 'true' to enable document-level persistence in Cloud Firestore alongside local atomic document store.
USE_FIRESTORE_HISTORY=false

# Firebase Firestore Configuration (for external VM / self-hosted environments)
FIREBASE_PROJECT_ID="nifty-art-czp2g"
FIRESTORE_DATABASE_ID="ai-studio-yachiruclickhous-d2e31be2-2e73-49b5-a7b3-25ca7280abb7"

# Distributed Caching & Rate Limiting (Redis)
# REDIS_URL: Redis connection URL for distributed rate limiting and multi-instance profile caching (e.g. redis://redis:6379 or rediss://user:pass@host:port).
# When not specified, Yachiru safely falls back to local in-memory caching and token-bucket rate limiting.
REDIS_URL=



